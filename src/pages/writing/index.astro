---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostListItem from "../../components/PostListItem.astro";
import { getCollection } from "astro:content";

// Public list MUST exclude status === "draft". Working + stable are shown.
const published = (
  await getCollection("writing", ({ data }) => data.status !== "draft")
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const essays = published.filter((p) => p.data.type === "essay");
const posts = published.filter((p) => p.data.type !== "essay");

// Section headings only make sense once there is more than one group to tell apart.
const showHeadings = essays.length > 0;
---

<BaseLayout
  title="Writing"
  description="Essays and notes on Bayesian computation, open-source probabilistic programming, and the epistemology of working with AI — living documents with status and last-updated dates."
>
  <section class="container section">
    <header class="writing-head">
      <h1>Writing</h1>
      <p class="muted writing-head__lede">
        Living documents: each carries a status and a last-updated date. Drafts are
        intentionally kept off this list until they are ready to be read.
      </p>
    </header>

    {
      published.length === 0 ? (
        <p class="muted">Nothing published yet.</p>
      ) : (
        <div class="writing-sections">
          {essays.length > 0 && (
            <section class="writing-group" aria-labelledby="essays-head">
              <div class="writing-group__head">
                <h2 id="essays-head" class="writing-group__title">
                  Essays
                </h2>
                <p class="writing-group__note muted">
                  Longer, evergreen pieces.
                </p>
              </div>
              <ol class="post-list">
                {essays.map((post) => (
                  <PostListItem post={post} />
                ))}
              </ol>
            </section>
          )}

          {posts.length > 0 && (
            <section
              class="writing-group"
              aria-labelledby={showHeadings ? "posts-head" : undefined}
            >
              {showHeadings && (
                <div class="writing-group__head">
                  <h2 id="posts-head" class="writing-group__title">
                    Posts
                  </h2>
                  <p class="writing-group__note muted">Shorter notes, newest first.</p>
                </div>
              )}
              <ol class="post-list">
                {posts.map((post) => (
                  <PostListItem post={post} />
                ))}
              </ol>
            </section>
          )}
        </div>
      )
    }
  </section>

  <style>
    .writing-head {
      max-width: var(--measure);
      margin-bottom: var(--space-xl);
    }
    .writing-head__lede {
      font-size: var(--step-0);
      margin-top: var(--space-s);
    }

    .writing-sections {
      display: flex;
      flex-direction: column;
      gap: var(--space-2xl);
    }
    .writing-group__head {
      margin-bottom: var(--space-m);
    }
    .writing-group__title {
      font-size: var(--step-1);
      margin: 0;
    }
    .writing-group__note {
      font-size: var(--step--1);
      margin-top: var(--space-xs);
    }

    .post-list {
      list-style: none;
      margin: 0;
      padding: 0;
      max-width: 60rem;
    }
  </style>
</BaseLayout>
