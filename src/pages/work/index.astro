---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkCard from "../../components/WorkCard.astro";
import {
  WORK,
  AREAS,
  ROOTS,
  AREA_LINKS,
  FEATURED_WORK,
  type WorkItem,
} from "../../data/work";
import { REVEAL_FLAGGED } from "../../config";

// Any future unannounced item lives ONLY in a gitignored sibling
// (work.secret.ts), so it never enters the public repo. import.meta.glob
// resolves to {} when the file is absent, so the build always succeeds.
const secretMods = import.meta.glob<{
  SECRET_WORK?: WorkItem[];
}>("../../data/work.secret.ts", { eager: true });
const secretWork = Object.values(secretMods).flatMap((m) => m.SECRET_WORK ?? []);

// Public filter: shown publicly AND (not flagged OR the reveal flag is on).
const items = [...WORK, ...secretWork].filter(
  (w) => w.public && (!w.flagged || REVEAL_FLAGGED),
);
const itemsFor = (area: string) => items.filter((w) => w.area === area);

// The agents-area "Yes" links to the proof post.
const framingHtml = (area: { id: string; framing: string }) =>
  area.id === "agents"
    ? area.framing.replace(
        "knowledge? Yes.",
        `knowledge? <a href="${AREA_LINKS.agentsYes}">Yes</a>.`,
      )
    : area.framing;
---

<BaseLayout
  title="Work"
  description="Autonomous science discovery with AI, plus open-source work in Bayesian computation and probabilistic programming."
>
  <section class="container section">
    <header class="work-intro flow">
      <p class="eyebrow">Work</p>
      <h1>What I'm working on</h1>
      <p class="muted work-intro__lede">
        Less a portfolio than a map of the threads I'm pulling on right now, and
        the questions underneath them. Most of the work happens in the open. If
        a thread interests you, come build.
      </p>
    </header>

    <section class="work-feature flow" aria-labelledby="featured-work-title">
      <p class="eyebrow">{FEATURED_WORK.title}</p>
      <h2 id="featured-work-title" class="work-feature__title">
        {FEATURED_WORK.headline}
      </h2>
      <p class="work-feature__role">{FEATURED_WORK.role}</p>
      <p class="work-feature__blurb">{FEATURED_WORK.blurb}</p>
      <ul class="work-feature__links" aria-label={`Links for ${FEATURED_WORK.title}`}>
        {
          FEATURED_WORK.links.map((link, index) => (
            <li>
              <a
                class:list={[
                  "work-feature__link",
                  { "work-feature__link--primary": index === 0 },
                ]}
                href={link.href}
                rel="noopener"
              >
                {link.label} <span aria-hidden="true">-&gt;</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <hr class="rule" />

    {
      AREAS.map((area) => (
        <section class="work-area flow" aria-labelledby={`area-${area.id}`}>
          <h2 id={`area-${area.id}`} class="work-area__title">
            {area.title}
          </h2>
          <p class="work-area__framing" set:html={framingHtml(area)} />
          <ul class="work-grid" role="list">
            {itemsFor(area.id).map((item) => (
              <li>
                <WorkCard item={item} />
              </li>
            ))}
          </ul>
          {area.id === "agents" && (
            <p class="muted work-area__more">
              Essays on this, as they land: see <a href="/writing/">Writing</a>.
            </p>
          )}
        </section>
      ))
    }

    <section class="work-roots flow" aria-labelledby="area-roots">
      <h2 id="area-roots" class="work-area__title work-roots__title">{ROOTS.title}</h2>
      <p>{ROOTS.body}</p>
      <p class="work-roots__tool">
        From that era: <a href={ROOTS.tool.href}>{ROOTS.tool.label}</a>, {ROOTS.tool.note}.
      </p>
      <p class="work-roots__caveat">{ROOTS.caveat}</p>
    </section>
  </section>
</BaseLayout>

<style>
  .work-intro__lede {
    max-width: var(--measure);
    font-size: var(--step-1);
  }

  .work-feature {
    margin-top: var(--space-xl);
    padding: clamp(var(--space-l), 5vw, var(--space-xl));
    border: 1px solid var(--rule);
    border-top: 4px solid var(--accent);
    background: var(--bg);
  }
  .work-feature__title {
    max-width: 18ch;
    font-size: var(--step-3);
    text-wrap: balance;
  }
  .work-feature__role {
    margin: 0;
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .work-feature__blurb {
    max-width: 62ch;
    color: var(--muted);
    font-size: var(--step-1);
  }
  .work-feature__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .work-feature__link {
    display: inline-flex;
    padding-block: 0.65rem;
    font-weight: 600;
  }
  .work-feature__link--primary {
    padding-inline: 1rem;
    background: var(--accent);
    color: var(--on-accent);
  }
  .work-feature__link--primary:hover,
  .work-feature__link--primary:focus-visible {
    text-decoration: none;
    background: var(--ink);
  }

  .work-area {
    margin-top: var(--space-xl);
  }
  .work-area__title {
    font-size: var(--step-1);
  }
  .work-area__framing {
    max-width: var(--measure);
    font-size: var(--step-0);
  }
  .work-area__more {
    font-size: var(--step--1);
  }

  .work-grid {
    list-style: none;
    margin: var(--space-s) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-l);
    grid-template-columns: 1fr;
  }
  .work-grid > li {
    display: flex;
  }
  .work-grid > li > * {
    width: 100%;
  }
  @media (min-width: 40rem) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .work-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Grayed "roots": lower-contrast text signals older / lower-confidence,
     mirroring the honest-epistemic-status house style. */
  .work-roots {
    margin-top: var(--space-xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--rule);
    color: var(--muted);
    max-width: var(--measure);
  }
  .work-roots__title {
    color: var(--muted);
  }
  .work-roots__tool {
    font-size: var(--step--1);
  }
  .work-roots__caveat {
    margin-top: var(--space-s);
    font-size: var(--step--2, 0.75rem);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .work-roots a {
    color: inherit;
    text-decoration: underline;
  }
</style>
