---
import type { CollectionEntry } from "astro:content";
import { lastUpdated } from "../lib/postDates";

interface Props {
  post: CollectionEntry<"writing">;
}

const { post } = Astro.props;
const updated = lastUpdated(post);

const fmtYear = (d: Date) => d.getFullYear().toString();
const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-CA", { year: "numeric", month: "short", day: "numeric" });
---

<li class="post-list__item">
  <a class="post-list__link" href={`/writing/${post.slug}/`}>
    <span class="post-list__year">{fmtYear(post.data.date)}</span>
    <span class="post-list__body">
      <span class="post-list__title">{post.data.title}</span>
      {
        post.data.description && (
          <span class="post-list__desc muted">{post.data.description}</span>
        )
      }
      <span class="post-list__meta">
        <span class={`post-list__status post-list__status--${post.data.status}`}>
          {post.data.status}
        </span>
        <span class="post-list__sep" aria-hidden="true">·</span>
        <span class="post-list__updated">
          Last updated
          <time datetime={updated.toISOString().slice(0, 10)}>{fmtDate(updated)}</time>
        </span>
      </span>
    </span>
  </a>
</li>

<style>
  .post-list__item {
    border-top: 1px solid var(--rule);
  }
  .post-list__item:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .post-list__link {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xs);
    padding-block: var(--space-l);
    color: var(--ink);
  }
  .post-list__link:hover {
    text-decoration: none;
  }
  @media (min-width: 40rem) {
    .post-list__link {
      grid-template-columns: 5rem 1fr;
      gap: var(--space-l);
      align-items: baseline;
    }
  }
  .post-list__year {
    font-size: var(--step--1);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .post-list__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .post-list__title {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .post-list__link:hover .post-list__title {
    color: var(--accent);
  }
  .post-list__desc {
    font-size: var(--step-0);
    max-width: var(--measure);
  }
  .post-list__meta {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--step--1);
    color: var(--muted);
    margin-top: var(--space-xs);
  }
  .post-list__status {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    font-size: 0.85em;
    color: var(--accent);
  }
  .post-list__sep {
    color: var(--rule);
  }
</style>
